# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=japanlanka
DATABASE_USER=your_username
DATABASE_PASSWORD=

# JWT Configuration (REQUIRED)
# SECURITY: You MUST set a unique, random secret key for production.
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
# The application will NOT start without this value.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Configuration (required for Google Sign-In)
# Download service account JSON from Firebase Console > Project Settings > Service Accounts
# Place the file in backend/keys/ directory (this directory is git-ignored)
FIREBASE_CREDENTIALS_PATH=keys/firebase-service-account.json

# PayHere Payment Gateway Configuration
# Get your credentials from PayHere Merchant Dashboard: https://www.payhere.lk/merchant
PAYHERE_MERCHANT_ID=1233973
PAYHERE_MERCHANT_SECRET=NjE4NDY5NDQ0MjE5MTgyNDgyNjM3NzA1NTk4OTEzNDQzMDQ5OTk4
PAYHERE_SANDBOX=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
