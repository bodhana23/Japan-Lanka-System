# =============================================================================
# Japan Lanka Backend — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Azure App Service (production), set each variable via:
#   Azure Portal > App Service > Configuration > Application Settings
#
# Do NOT commit .env to version control (it is in .gitignore).
# =============================================================================

# --- Database ---
# Local dev: use your local PostgreSQL instance
# Azure: get the connection details from
#   Azure Portal > PostgreSQL Flexible Server > Connection strings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=japanlanka
DATABASE_USER=your_local_pg_user
DATABASE_PASSWORD=your_local_pg_password
# Note: Azure PostgreSQL enforces SSL by default. The psycopg driver handles
# this automatically when connecting to *.postgres.database.azure.com

# --- JWT ---
# REQUIRED — app will fail to start if not set (no insecure default).
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Firebase Admin SDK ---
# Option A — Local development: path to the downloaded service account JSON file.
#   Download from: Firebase Console > Project Settings > Service Accounts > Generate key
FIREBASE_CREDENTIALS_PATH=keys/firebase-service-account.json
#
# Option B — Cloud deployment (Azure App Service): paste the ENTIRE JSON content
#   of the service account file as a single-line string. When this is set,
#   FIREBASE_CREDENTIALS_PATH is ignored.
#   In Azure portal, set FIREBASE_CREDENTIALS_JSON to the full JSON.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CLOCK_SKEW_SECONDS=10

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev default: covers both standard Vite dev ports.
# Production: replace with your Azure Static Web App URL.
# Example: CORS_ORIGINS_STR=https://your-app.azurestaticapps.net
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- App URLs ---
# Used for PayHere payment gateway callback/return URLs.
# MUST be overridden in production.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- PayHere Payment Gateway ---
# Get credentials from https://www.payhere.lk/merchant
# Set PAYHERE_SANDBOX=false in production.
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true
