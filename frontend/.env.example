# =============================================================================
# Japan Lanka Frontend — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Azure Static Web Apps (production), set each VITE_* variable in:
#   Azure Portal > Static Web App > Configuration > Application Settings
#
# IMPORTANT: Vite bakes VITE_* values into the JavaScript bundle at BUILD TIME.
# They must be available when running 'npm run build', not at container runtime.
# In GitHub Actions, they are passed as build-time env vars from GitHub Secrets.
#
# Do NOT commit .env to version control (it is in .gitignore).
# =============================================================================

# --- Backend API ---
# Local dev:  http://localhost:8000/api/v1
# Production: https://your-backend.azurewebsites.net/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# --- Firebase Client SDK ---
# These values are SAFE TO EXPOSE publicly — Firebase client config is always
# browser-visible by design. Firebase Security Rules protect your data.
# Get all values from:
#   Firebase Console > Project Settings > Your apps > Web app > SDK setup & config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- PayHere Payment Gateway ---
# Get from https://www.payhere.lk/merchant
# Set VITE_PAYHERE_SANDBOX=false in production.
VITE_PAYHERE_MERCHANT_ID=your_merchant_id
VITE_PAYHERE_SANDBOX=true
