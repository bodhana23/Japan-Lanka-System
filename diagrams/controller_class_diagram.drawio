        <!-- AuditorController -->
        <mxCell id="11" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;AuditorController&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-size:10px;font-style:italic;&quot;&gt;prefix: /api/v1/auditor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:2px solid #000000;padding:4px;font-size:11px;&quot;&gt;+ GET /inventory-logs : InventoryLogListResponse [require_auditor]&lt;br&gt;+ GET /activity-logs : ActivityLogListResponse [require_auditor]&lt;br&gt;+ GET /export/inventory : Excel [require_auditor]&lt;br&gt;+ GET /export/activity : Excel [require_auditor]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;overflow=hidden;rotatable=0;" vertex="1" parent="1">
