        <!-- AnalyticsController -->
        <mxCell id="12" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;AnalyticsController&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-size:10px;font-style:italic;&quot;&gt;prefix: /api/v1/analytics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:2px solid #000000;padding:4px;font-size:11px;&quot;&gt;+ GET /financial-summary : FinancialSummaryResponse [require_staff]&lt;br&gt;+ GET /returns : ReturnAnalyticsResponse [require_staff]&lt;br&gt;+ GET /order-pipeline : OrderPipelineResponse [require_staff]&lt;br&gt;+ GET /sales-channels : SalesChannelComparisonResponse [require_staff]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;overflow=hidden;rotatable=0;" vertex="1" parent="1">
