          <mxGeometry x="460" y="1060" width="380" height="145" as="geometry" />
        </mxCell>

        <!-- ==================== AUTH DEPENDENCIES LEGEND ==================== -->
        <mxCell id="99" value="&lt;table border=&quot;0&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#333333;color:white;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;Auth Dependency Legend&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:2px solid #333333;padding:6px;font-size:11px;background:#f9f9f9;&quot;&gt;&lt;b&gt;[public]&lt;/b&gt; = No authentication required&lt;br&gt;&lt;b&gt;[require_customer]&lt;/b&gt; = get_current_customer — customer JWT only&lt;br&gt;&lt;b&gt;[require_employee]&lt;/b&gt; = get_current_employee — any employee JWT&lt;br&gt;&lt;b&gt;[current_user]&lt;/b&gt; = get_current_user — customer OR employee JWT&lt;br&gt;&lt;b&gt;[require_manager_or_admin]&lt;/b&gt; = role: MANAGER or ADMIN&lt;br&gt;&lt;b&gt;[require_manager_only]&lt;/b&gt; = role: MANAGER only&lt;br&gt;&lt;b&gt;[require_admin]&lt;/b&gt; = role: ADMIN only&lt;br&gt;&lt;b&gt;[require_auditor]&lt;/b&gt; = role: AUDITOR only&lt;br&gt;&lt;b&gt;[require_staff]&lt;/b&gt; = any employee (MANAGER, ADMIN, or AUDITOR)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#333333;fillColor=#ffffff;align=left;verticalAlign=top;overflow=hidden;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="1060" width="480" height="285" as="geometry" />
        </mxCell>

        <!-- ==================== COLOR LEGEND ==================== -->
        <mxCell id="98" value="&lt;table border=&quot;0&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#333333;color:white;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;Controller Color Legend&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:2px solid #333333;padding:6px;font-size:11px;background:#f9f9f9;&quot;&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Dark Blue&lt;/span&gt; = Authentication controllers&lt;br&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Teal&lt;/span&gt; = Customer-facing (Products, Orders, Cart)&lt;br&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Red&lt;/span&gt; = Returns and Notifications&lt;br&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Purple&lt;/span&gt; = Staff analytics and Inventory&lt;br&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Brown&lt;/span&gt; = Admin-only (Users, Ads, Settings, Payments)&lt;br&gt;&lt;span style=&quot;background:#000000;color:white;padding:1px 4px;&quot;&gt;Grey-blue&lt;/span&gt; = Auditor only&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#333333;fillColor=#ffffff;align=left;verticalAlign=top;overflow=hidden;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1060" width="400" height="220" as="geometry" />
        </mxCell>

