        <mxCell id="26" value="&lt;table border=&quot;0&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-size:10px;font-style:italic;&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; (CartContext)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#000000;color:white;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;CartItem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:2px solid #000000;padding:4px;font-size:11px;&quot;&gt;id : string&lt;br&gt;productId : string&lt;br&gt;name : string&lt;br&gt;brand : string&lt;br&gt;model : string&lt;br&gt;price : number&lt;br&gt;quantity : number&lt;br&gt;quantityAvailable : number&lt;br&gt;image? : string&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;verticalAlign=top;overflow=hidden;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="1840" width="300" height="270" as="geometry" />
        </mxCell>

        <!-- ==================== RELATIONSHIPS ==================== -->
